+"""Feed reliability: a synthetic stream goes back to Binance, one failed REST call doesn't demote Binance for every
+caller, a 429 pauses instead of serving demo data, and a signal check that misses its candle is tried again."""
+
+import asyncio
+import dataclasses
+import time
+
+import httpx
+import numpy as np
+import pandas as pd
+import pytest
+
+from app import market_data, signal_alerts, stream_hub
+from app.alerts import AlertService
+from app.config import Settings
+from app.jobs import jobs
+from app.market_data import FALLBACK_SYMBOLS, MarketData, MarketDataError, synthetic_klines
+from app.schemas import Candle, KimiSignal
+from app.signal_alerts import SignalAlertService
+from app.stream_hub import StreamHub
+
+T0, STEP = 1_700_000_000, 3600
+
+
+# ------------------------------------------------------------------ stream hub --
+
+
+class HubMarket:
+    """binance_usable / mark_binance_down like MarketData, with synthetic candles."""
+
+    def __init__(self, usable: bool):
+        self.usable, self.demoted = usable, 0
+        self.settings = Settings(data_source="auto")
+
+    def binance_usable(self):
+        return self.usable
+
+    def mark_binance_down(self, seconds: float = 60.0):
+        self.demoted += 1
+        self.usable = False
+
+    async def get_klines(self, symbol, interval, limit):
+        return synthetic_klines(symbol, interval, limit), "synthetic"
+
+
+def _fake_binance(hub, fail_first: bool):
+    attempts: list[str] = []
+
+    async def run(stream):
+        attempts.append(stream.source)
+        if fail_first and len(attempts) == 1:
+            raise OSError("connect refused")
+        hub._set_source(stream, "binance")
+        await asyncio.Event().wait()  # stays connected
+
+    return run, attempts
+
+
+async def _status(queue, source, timeout=5.0):
+    async def wait():
+        while True:
+            msg = await queue.get()
+            if msg["type"] == "status" and msg["source"] == source:
+                return msg
+    return await asyncio.wait_for(wait(), timeout)
+
+
+def test_synthetic_stream_goes_back_to_binance(monkeypatch):
+    monkeypatch.setattr(stream_hub, "SYNTHETIC_RECHECK", 0.0, raising=False)
+
+    async def go():
+        market = HubMarket(usable=False)
+        hub = StreamHub(market)
+        run, attempts = _fake_binance(hub, fail_first=False)
+        monkeypatch.setattr(hub, "_run_binance", run)
+        queue = await hub.subscribe("INJUSDT", "1h")
+        await _status(queue, "synthetic")
+        market.usable = True  # Binance answers again
+        await _status(queue, "binance")
+        assert attempts == ["synthetic"] and hub.stats()[0]["source"] == "binance"
+        await hub.shutdown()
+
+    asyncio.run(go())
+
+
+def test_a_stream_connect_failure_does_not_demote_rest(monkeypatch):
+    async def go():
+        market = HubMarket(usable=True)
+        hub = StreamHub(market)
+        run, attempts = _fake_binance(hub, fail_first=True)
+        monkeypatch.setattr(hub, "_run_binance", run)
+        queue = await hub.subscribe("INJUSDT", "1h")
+        await _status(queue, "binance")
+        assert market.demoted == 0 and market.usable  # REST callers stay on Binance
+        assert len(attempts) == 2
+        await hub.shutdown()
+
+    asyncio.run(go())
+
+
+# ----------------------------------------------------------------- market data --
+
+
+def _rows(n=5):
+    now_h = int(time.time()) // STEP * STEP
+    return [[(now_h - (n - 1 - i) * STEP) * 1000, "1", "2", "0.5", "1.5", "10", 0, "0", 1, "0", "0", "0"]
+            for i in range(n)]
+
+
+def _md(handler) -> MarketData:
+    md = MarketData()
+    md.settings = dataclasses.replace(md.settings, data_source="auto")
+    if md._store is not None:
+        md._store.close()
+        md._store = None
+    md._client = httpx.AsyncClient(transport=httpx.MockTransport(handler))
+    return md
+
+
+@pytest.fixture
+def no_jitter(monkeypatch):
+    monkeypatch.setattr(market_data, "RETRY_JITTER", (0.0, 0.0), raising=False)
+
+
+def test_one_failed_request_is_retried(no_jitter):
+    calls = []
+
+    def handler(req):
+        calls.append(req.url.path)
+        if len(calls) == 1:
+            raise httpx.ConnectError("blip")
+        return httpx.Response(200, json=_rows())
+
+    md = _md(handler)
+    candles, source = asyncio.run(md.get_klines("BTCUSDT", "1h", 5))
+    assert source == "binance" and len(candles) == 5 and md.binance_usable()
+    assert calls == ["/api/v3/klines", "/api/v3/klines"]
+
+
+def test_binance_is_demoted_only_after_three_failures_while_ping_answers(no_jitter):
+    pings = []
+
+    def handler(req):
+        if req.url.path == "/api/v3/ping":
+            pings.append(1)
+            return httpx.Response(200, json={})
+        return httpx.Response(503)
+
+    md = _md(handler)
+
+    async def go():
+        for i, limit in enumerate((10, 11, 12)):  # different requests, so no cache hits
+            candles, source = await md.get_klines("BTCUSDT", "1h", limit)
+            assert source == "synthetic" and len(candles) == limit
+            assert md.binance_usable() == (i < 2), i
+        await md.close()
+
+    asyncio.run(go())
+    assert len(pings) == 2
+
+
+def test_rate_limit_pauses_instead_of_serving_demo_data(no_jitter):
+    calls = []
+
+    def handler(req):
+        calls.append(req.url.path)
+        return httpx.Response(429, headers={"Retry-After": "30"}, json={"code": -1003, "msg": "Too many requests"})
+
+    md = _md(handler)
+
+    async def go():
+        with pytest.raises(MarketDataError):
+            await md.get_klines("BTCUSDT", "1h", 10)
+        assert calls == ["/api/v3/klines"]  # not retried, no ping
+        assert md.binance_usable()  # never switched to synthetic
+        with pytest.raises(MarketDataError):
+            await md.get_klines("ETHUSDT", "1h", 10)
+        assert calls == ["/api/v3/klines"]  # paused: nothing sent until Retry-After has passed
+        await md.close()
+
+    asyncio.run(go())
+
+
+def test_symbol_list_keeps_the_last_good_list(no_jitter):
+    state = {"up": True}
+
+    def handler(req):
+        if state["up"]:
+            return httpx.Response(200, json={"symbols": [
+                {"symbol": "AAAUSDT", "status": "TRADING", "quoteAsset": "USDT"},
+                {"symbol": "BBBUSDT", "status": "TRADING", "quoteAsset": "USDT"}]})
+        raise httpx.ConnectError("offline")
+
+    async def go():
+        md = _md(handler)
+        assert await md.list_symbols() == ["AAAUSDT", "BBBUSDT"]
+        md._symbols = (time.monotonic() - 1, md._symbols[1])  # expired
+        state["up"] = False
+        assert await md.list_symbols() == ["AAAUSDT", "BBBUSDT"]
+        assert md._symbols[0] - time.monotonic() <= 61  # looked up again in a minute
+        await md.close()
+
+        md = _md(handler)  # never had a good list: the built-in one, also for a minute only
+        assert await md.list_symbols() == FALLBACK_SYMBOLS
+        assert md._symbols[0] - time.monotonic() <= 61
+        await md.close()
+
+    asyncio.run(go())
+
