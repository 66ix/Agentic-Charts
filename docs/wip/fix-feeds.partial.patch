+# --------------------------------------------------------------- signal alerts --
+
+
+def _bars(closes, last=None) -> pd.DataFrame:
+    c = np.asarray(closes, dtype=float)
+    o = np.concatenate([c[:1], c[:-1]])
+    df = pd.DataFrame({"time": T0 + np.arange(len(c)) * STEP, "open": o, "high": np.maximum(o, c) + 0.3,
+                       "low": np.minimum(o, c) - 0.3, "close": c, "volume": np.full(len(c), 100.0)})
+    for k, v in (last or {}).items():
+        df.loc[len(df) - 1, k] = v
+    return df
+
+
+def _sweep_low_df():
+    closes = list(np.linspace(100, 106, 60)) + [104, 101, 98, 96, 95.3] + list(np.linspace(96.5, 104, 10)) + [102]
+    return _bars(closes, {"open": 103.5, "low": 94.0, "high": 103.8, "close": 102.0})
+
+
+class FakeHub:
+    def __init__(self):
+        self.queues: dict[tuple, asyncio.Queue] = {}
+
+    async def subscribe(self, symbol, interval):
+        self.queues[(symbol, interval)] = asyncio.Queue()
+        return self.queues[(symbol, interval)]
+
+    async def unsubscribe(self, symbol, interval, queue):
+        self.queues.pop((symbol, interval), None)
+
+    def push(self, symbol, interval, t, source="binance", closed=False):
+        self.queues[(symbol, interval)].put_nowait({
+            "type": "kline", "symbol": symbol, "interval": interval, "source": source, "closed": closed,
+            "candle": {"time": t, "open": 1, "high": 1, "low": 1, "close": 1, "volume": 1}})
+
+
+class FakeMarket:
+    def __init__(self, df, source="binance"):
+        self.df, self.source, self.calls = df, source, 0
+
+    async def get_klines(self, symbol, interval, limit):
+        self.calls += 1
+        rows = self.df.tail(limit)
+        return [Candle(**{k: r[k] for k in ("time", "open", "high", "low", "close", "volume")})
+                for r in rows.to_dict("records")], self.source
+
+
+class FakeKimi:
+    def __init__(self, responses):
+        self.responses, self.calls = list(responses), 0
+
+    async def get(self, symbol, interval):
+        self.calls += 1
+        return self.responses.pop(0) if len(self.responses) > 1 else self.responses[0]
+
+
+class KimiResp:
+    def __init__(self, last_closed, signals, data_source="binance"):
+        self.last_closed, self.signals, self.data_source = last_closed, signals, data_source
+
+
+def _service(hub, market, kimi=None):
+    settings = Settings(alerts_store="memory", alert_history_store="memory", signal_alerts_store="memory",
+                        data_source="auto", telegram_bot_token="", telegram_chat_id="", discord_webhook_url="")
+    alerts = AlertService(hub, settings)
+    return alerts, SignalAlertService(hub, market, kimi, alerts, settings, close_delay=0, retry_delay=0.01)
+
+
+async def _until(cond, timeout=3.0):
+    for _ in range(int(timeout / 0.01)):
+        if cond():
+            return
+        await asyncio.sleep(0.01)
+    raise AssertionError("condition not met")
+
+
+def _job(name="signal_alerts") -> dict:
+    return next((j for j in jobs.status() if j["name"] == name), {})
+
+
+@pytest.fixture
+def quick_recheck(monkeypatch):
+    monkeypatch.setattr(signal_alerts, "RECHECK_DELAY", 0.02, raising=False)
+    monkeypatch.setattr(signal_alerts, "RECHECK_FOR", 5.0, raising=False)
+
+
+def test_a_candle_seen_only_as_synthetic_is_judged_again():
+    df = _sweep_low_df()
+    t = int(df["time"].iloc[-1])
+
+    async def go():
+        hub, market = FakeHub(), FakeMarket(df, source="synthetic")
+        alerts, svc = _service(hub, market)
+        await svc.add(["INJUSDT"], "1h", "sweep_low")
+        assert await svc.on_bar_close("INJUSDT", "1h", t) == []  # not judged: demo candles
+        market.source = "binance"
+        fired = await svc.on_bar_close("INJUSDT", "1h", t)
+        assert len(fired) == 1 and fired[0].last_bar == t
+        assert await svc.on_bar_close("INJUSDT", "1h", t) == []  # judged once
+        await svc.close()
+        await alerts.close()
+
+    asyncio.run(go())
+
+
+def test_feed_blip_at_the_close_is_retried(quick_recheck):
+    df = _sweep_low_df()
+    t = int(df["time"].iloc[-1])
+
+    async def go():
+        hub, market = FakeHub(), FakeMarket(df, source="synthetic")  # REST blipped to demo candles
+        alerts, svc = _service(hub, market)
+        await svc.add(["INJUSDT"], "1h", "sweep_low")
+        hub.push("INJUSDT", "1h", t)
+        hub.push("INJUSDT", "1h", t + STEP)  # candle t closed
+        await _until(lambda: market.calls >= 2)  # tried, got demo candles, tried again
+        market.source = "binance"
+        await _until(lambda: svc.list()[0].fire_count == 1)
+        assert _job()["state"] == "ok"
+        await svc.close()
+        await alerts.close()
+
+    asyncio.run(go())
+
+
+def test_kimi_on_demo_data_is_retried(quick_recheck):
+    df = _bars(list(100 + np.sin(np.arange(100) * 2 * np.pi / 8)))
+    t = int(df["time"].iloc[-1])
+    sig = KimiSignal(type="DIV", direction="long", text="B+", time=t - 3 * STEP, confirm_time=t, price=64210.0,
+                     entry=64210.0, confluence=3, tier="top", result="open")
+
+    async def go():
+        hub, market = FakeHub(), FakeMarket(df)
+        kimi = FakeKimi([KimiResp(t, [], "synthetic"), KimiResp(t, [sig])])
+        alerts, svc = _service(hub, market, kimi)
+        await svc.add(["BTCUSDT"], "1h", "kimi_buy")
+        hub.push("BTCUSDT", "1h", t)
+        hub.push("BTCUSDT", "1h", t + STEP)
+        await _until(lambda: svc.list()[0].fire_count == 1)
+        assert kimi.calls == 2
+        await svc.close()
+        await alerts.close()
+
+    asyncio.run(go())
+
+
+def test_giving_up_reports_and_the_next_live_tick_requeues(monkeypatch):
+    monkeypatch.setattr(signal_alerts, "RECHECK_DELAY", 0.01, raising=False)
+    monkeypatch.setattr(signal_alerts, "RECHECK_FOR", 0.05, raising=False)
+    df = _sweep_low_df()
+    t = int(df["time"].iloc[-1])
+
+    async def go():
+        hub, market = FakeHub(), FakeMarket(df, source="synthetic")
+        alerts, svc = _service(hub, market)
+        await svc.add(["INJUSDT"], "1h", "sweep_low")
+        started = time.time()
+        hub.push("INJUSDT", "1h", t)
+        hub.push("INJUSDT", "1h", t + STEP)
+        await _until(lambda: (_job().get("last_fail") or 0) >= started)
+        assert _job()["state"] == "error" and "INJUSDT 1h" in _job()["last_error"]
+        assert svc.list()[0].fire_count == 0
+        market.source = "binance"  # Binance is back
+        hub.push("INJUSDT", "1h", t + STEP)  # the next tick of the forming candle
+        await _until(lambda: svc.list()[0].fire_count == 1)
+        assert svc.list()[0].last_bar == t
+        await svc.close()
+        await alerts.close()
+
+    asyncio.run(go())
+
+
+def test_a_stream_off_binance_for_long_is_reported(monkeypatch):
+    monkeypatch.setattr(signal_alerts, "FEED_DOWN_AFTER", 0.05, raising=False)
+    df = _sweep_low_df()
+    t = int(df["time"].iloc[-1])
+
+    async def go():
+        hub, market = FakeHub(), FakeMarket(df)
+        alerts, svc = _service(hub, market)
+        await svc.add(["INJUSDT"], "1h", "sweep_low")
+        started = time.time()
+        hub.push("INJUSDT", "1h", t, source="synthetic")
+        await asyncio.sleep(0.1)
+        hub.push("INJUSDT", "1h", t, source="synthetic")
+        await _until(lambda: (_job().get("last_fail") or 0) >= started)
+        assert "INJUSDT 1h" in _job()["last_error"] and "paused" in _job()["last_error"]
+        await svc.close()
+        await alerts.close()
+
+    asyncio.run(go())
