# ---- Market data ----------------------------------------------------------
# auto      = use Binance, fall back to a synthetic feed if Binance is unreachable
# binance   = Binance only (errors surface to the client)
# synthetic = offline demo feed (no network needed)
DATA_SOURCE=auto
# Binance blocks some regions (e.g. US IPs get HTTP 451). When the primary
# endpoints answer 451/403 the backend switches to the fallback automatically.
#   https://data-api.binance.vision        + wss://data-stream.binance.vision/ws
#   https://api.binance.us                 + wss://stream.binance.us:9443/ws
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_FALLBACK_REST_URL=https://data-api.binance.vision
BINANCE_FALLBACK_WS_URL=wss://data-stream.binance.vision/ws
# Closed Binance candles are kept in SQLite, so a restart only downloads the
# bars opened since. Synthetic data is never cached. off disables it.
CANDLE_CACHE=on
# CANDLE_CACHE_PATH=.cache/candles.sqlite3

# ---- Header derivatives (Binance USD-M futures, free, no key) -------------
# Open interest sums the top OI_TOP_SYMBOLS USDT perpetuals. Liquidations come
# from the !forceOrder@arr stream, kept as a rolling 24h window in
# LIQUIDATIONS_STORE. Binance futures is unavailable from US IPs; the header
# then shows mocked values, marked as such. DERIVATIVES=off disables both.
DERIVATIVES=on
BINANCE_FUTURES_REST_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/market/ws
OI_TOP_SYMBOLS=40
# LIQUIDATIONS_STORE=.cache/liquidations.json

# ---- LLM (optional: analysis works without any LLM) ----------------------
# ollama | openai | anthropic | none
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=30

# Under Docker this comes from docker-compose.yml instead (host.docker.internal).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Context window asked of Ollama. Its default on GPUs under 24 GB is 4096, which
# silently cuts the agent's tool calls. 0 = Ollama's own default.
OLLAMA_NUM_CTX=8192

# Any OpenAI-compatible endpoint (OpenAI, Groq, Together, vLLM, LM Studio...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Agent ----------------------------------------------------------------
# tools  = the model may look at other timeframes/coins, scan the watchlist and
#          read funding/OI (up to AGENT_MAX_STEPS calls) before it draws
# single = one planning call (for models without tool support)
AGENT_MODE=tools
AGENT_MAX_STEPS=4

# ---- Rate limits (per client; 0 = off) ------------------------------------
# Format: N/second, N/minute, N/hour or N/day.
AGENT_RATE_LIMIT=20/minute
API_RATE_LIMIT=300/minute
# Agent requests per day for the whole server, to cap LLM spend (0 = off).
AGENT_DAILY_LIMIT=0
# Number of reverse proxies in front of the API (Caddy/nginx = 1). The rate
# limiter then reads the client IP from X-Forwarded-For. Keep 0 when clients
# reach the API directly, or they could fake their IP.
TRUST_PROXY=0

# ---- Price alerts ---------------------------------------------------------
# Alerts are stored and checked on the server, so they fire with the browser
# closed. ALERTS_STORE=memory keeps them in memory only (lost on restart).
# ALERTS_STORE=.cache/alerts.json
#
# Telegram: create a bot with @BotFather (/newbot) for the token, send your bot a
# message, then read "chat":{"id":...} from
# https://api.telegram.org/bot<TOKEN>/getUpdates. Both are needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# ---- Alert history, signal alerts and the brief ---------------------------
# Every fired price alert, signal alert ("Kimi printed B+ on BTC 4h", RSI
# divergence, sweep of a low, new demand zone...) and brief is kept in the alert
# history (last 500). Signal alerts are checked when a candle closes and notify
# through TELEGRAM_* / DISCORD_WEBHOOK_URL above, like price alerts. The brief
# (Alerts panel > Brief) is sent at the local times you choose. Each is a JSON
# file; `memory` keeps it in memory only (lost on restart).
# ALERT_HISTORY_STORE=.cache/alert_history.json
# SIGNAL_ALERTS_STORE=.cache/signal_alerts.json
# BRIEF_STORE=.cache/brief.json

# ---- Server ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
METRICS_CACHE_SECONDS=60

# ---- Grid bot tracker -----------------------------------------------------
# Binance Spot Grid bots you track in the app, replayed on 1-minute candles.
# GRIDBOTS_STORE=memory keeps them in memory only (lost on restart).
# GRIDBOTS_STORE=.cache/gridbots.json

# ---- Trade journal --------------------------------------------------------
# Trades you log (from the agent's plan card or by hand) are tracked on 1m
# candles. JOURNAL_STORE=memory keeps them in memory only (lost on restart).
# JOURNAL_STORE=.cache/journal.json

# ---- Market data panel, economic calendar and news ------------------------
# Funding, open interest, long/short ratios and the estimated liquidation
# levels use BINANCE_FUTURES_REST_URL and DERIVATIVES above (Binance futures
# blocks US IPs; the panel then says so). CVD and order-book walls use spot.
# Economic calendar: Forex Factory-format JSON feeds, cached for an hour.
# Next week's feed appears late in the week; until then it is skipped.
CALENDAR_URLS=https://nfs.faireconomy.media/ff_calendar_thisweek.json,https://nfs.faireconomy.media/ff_calendar_nextweek.json
# Currencies kept from the calendar (comma list), or ALL.
CALENDAR_COUNTRIES=USD
# RSS or Atom news feeds (comma list), cached for five minutes.
NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss

# ---- Binance account import (optional, READ-ONLY key) ----------------------
# Imports your spot and USD-M futures fills into the trade journal and shows your
# positions. Create the key on Binance (API Management) with ONLY "Enable Reading"
# ticked: no trading, no withdrawals, no transfers. The backend asks Binance what
# the key may do and refuses one that can trade or withdraw. You can also enter
# the key in the app (Account tab); it is then kept in BINANCE_KEY_STORE with
# file mode 600. These two win over a key entered in the app.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_KEY_STORE=.cache/binance_key.json
# Imported fills, classifications and import settings (mode 600 too).
# BINANCE_IMPORT_STORE=.cache/binance_import.json
